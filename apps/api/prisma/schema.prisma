generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum GoalStatus {
  ACTIVE
  COMPLETED
  ARCHIVED
}

enum TaskStatus {
  INBOX
  IN_PROGRESS
  DONE
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
}

model User {
  id         String       @id @default(uuid())
  email      String       @unique
  name       String

  goals      Goal[]
  tasks      Task[]
  dailyFocus DailyFocus[]

  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt

  @@map("users")
}

model Goal {
  id          String     @id @default(uuid())
  userId      String
  title       String
  description String?
  status      GoalStatus @default(ACTIVE)

  user        User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  tasks       Task[]

  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@index([userId])
  @@map("goals")
}

model Task {
  id          String       @id @default(uuid())
  userId      String
  goalId      String?

  title       String
  description String?
  status      TaskStatus   @default(INBOX)
  priority    TaskPriority @default(MEDIUM)
  dueDate     DateTime?

  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  goal        Goal?        @relation(fields: [goalId], references: [id], onDelete: SetNull)
  dailyFocus  DailyFocus[]

  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@index([userId])
  @@index([goalId])
  @@index([status])
  @@index([dueDate])
  @@map("tasks")
}

model DailyFocus {
  id        String   @id @default(uuid())
  userId    String
  taskId    String
  date      DateTime

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([userId, date])
  @@index([taskId])
  @@map("daily_focus")
}
